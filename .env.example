PUBLIC_URL=https://jklist.com

# Required when PUBLIC_URL is https. Empty means codes print to the console.
RESEND_API_KEY=
MAIL_FROM=jklist <hello@jklist.com>

# Email for replies. Each conversation gets private addresses at this domain, which
# needs Resend receiving (an MX record), a webhook for email.received at
# <PUBLIC_URL>/inbound, and a full-access API key. Empty means replies are off.
RELAY_DOMAIN=
RESEND_WEBHOOK_SECRET=

# Comma-separated.
ADMIN_EMAILS=

# When set, requests must carry this value in an x-origin-secret header.
# Add the header with a Cloudflare request header transform rule.
ORIGIN_SECRET=

# 1 stops sign-ins, posts and uploads. Reading and deleting still work.
READ_ONLY=

# 1 prints one line per request: path without the query, status, Accept header and
# user agent. For checking how agents fetch the site.
LOG_REQUESTS=

CODES_PER_HOUR=200
POSTS_PER_HOUR=300
REPLIES_PER_HOUR=300
UPLOADS_MAX_MB=800

# Unexpected errors are sent here when set.
SENTRY_DSN=

# A file the nightly off-site backup touches. When set, /health fails if it's
# more than 36 hours old.
BACKUP_STAMP=

# The content of Google Search Console's HTML-tag verification, if you use that method.
GOOGLE_SITE_VERIFICATION=

# 32 lowercase hex characters. When set, new and changed posts are announced to
# Bing and other IndexNow search engines, and /<key>.txt proves the site owns the key.
INDEXNOW_KEY=

DB_FILE=./jklist.db
UPLOADS_DIR=./uploads
BACKUP_DIR=./backups
